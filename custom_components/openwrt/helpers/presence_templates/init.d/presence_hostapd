#!/bin/sh /etc/rc.common
# OpenWrt procd service for hostapd_cli action hooks

START=95
STOP=10
USE_PROCD=1

ACTION="/etc/presence/presence_event.sh"

start_service() {
  [ -x "$ACTION" ] || return 0

  # Detect active interfaces purely from the live hostapd control sockets that
  # respond to a ping. If hostapd is still initializing (e.g. during boot or DFS CAC),
  # retry briefly in a background loop before giving up.
  ACTIVE_SOCKS=""

  # Search standard and vendor-specific hostapd control socket paths.
  for sock in /var/run/hostapd/* /var/run/hostapd-*/*; do
    [ -e "$sock" ] || continue
    IFACE=$(basename "$sock")
    CTRL_DIR=$(dirname "$sock")
    [ "$IFACE" = "global" ] && continue
    if hostapd_cli -i "$IFACE" -p "$CTRL_DIR" ping 2>/dev/null | grep -q PONG; then
      ACTIVE_SOCKS="$ACTIVE_SOCKS $sock"
    fi
  done

  # If no healthy interface answered yet, launch background retry to restart service
  # once hostapd finishes starting up (e.g. on 5GHz DFS wait or slow boot).
  if [ -z "$ACTIVE_SOCKS" ]; then
    (
      for _i in $(seq 1 12); do
        sleep 5
        for sock in /var/run/hostapd/* /var/run/hostapd-*/*; do
          [ -e "$sock" ] || continue
          _cand=$(basename "$sock")
          [ "$_cand" = "global" ] && continue
          CTRL_DIR=$(dirname "$sock")

          if hostapd_cli -i "$_cand" -p "$CTRL_DIR" ping 2>/dev/null | grep -q PONG; then
            /etc/init.d/presence_hostapd restart
            exit 0
          fi
        done
      done
    ) 1000>&- >/dev/null 2>&1 &
    return 0
  fi

  [ -n "$ACTIVE_SOCKS" ] || return 0

  for sock in $ACTIVE_SOCKS; do
    IFACE=$(basename "$sock")
    CTRL_DIR=$(dirname "$sock")
    procd_open_instance "$IFACE"
    procd_set_param command /usr/sbin/hostapd_cli -i "$IFACE" -p "$CTRL_DIR" -a "$ACTION"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
  done

  # Initial scan of currently connected stations upon service start
  (
    sleep 10
    for sock in $ACTIVE_SOCKS; do
      IFACE=$(basename "$sock")
      [ -d "/sys/class/net/$IFACE" ] || continue
      (
        # Read iwinfo first so any link MAC with an MLD address can be mapped to
        # its canonical MLD address before processing iw station dump output.
        iwinfo "$IFACE" assoclist 2>/dev/null | sed 's/^/IWINFO /'
        iw dev "$IFACE" station dump 2>/dev/null | sed 's/^/IW /'
      ) \
      | awk '
        /^IWINFO [0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}/ {
          if (device_mac != "") {
            print device_mac
          }
          device_mac = tolower($2)
          next
        }
        /^IWINFO .*mld addr:/ {
          for (i = 1; i <= NF; i++) {
            if ($i == "mld" && $(i + 1) == "addr:" && (i + 2) <= NF) {
              mld = tolower($(i + 2))
              if (device_mac != "") {
                mld_map[device_mac] = mld
              }
              print mld
              device_mac = ""
              break
            }
          }
          next
        }
        /^IW Station / {
          if (device_mac != "") {
            print device_mac
            device_mac = ""
          }
          mac = tolower($3)
          if (mac in mld_map) {
            print mld_map[mac]
          } else {
            print mac
          }
          next
        }
        END {
          if (device_mac != "") {
            print device_mac
          }
        }' \
      | sort -u \
      | while read -r MAC; do
          [ -n "$MAC" ] && "$ACTION" "$IFACE" "AP-STA-CONNECTED" "$MAC"
        done
    done
  ) 1000>&- >/dev/null 2>&1 &
}

service_triggers() {
  # Restart when wireless is reloaded
  procd_add_reload_trigger "wireless"
}
