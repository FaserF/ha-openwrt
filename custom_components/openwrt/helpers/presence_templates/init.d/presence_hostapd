>>>>>>> upstream/main

  [ -n "$ACTIVE_SOCKS" ] || return 0

  for sock in $ACTIVE_SOCKS; do
    IFACE=$(basename "$sock") 
    CTRL_DIR=$(dirname "$sock")
    procd_open_instance "$IFACE"
    procd_set_param command /usr/sbin/hostapd_cli -i "$IFACE" -p "$CTRL_DIR" -a "$ACTION"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
  done

  # Initial scan of currently connected stations upon service start
  (
    sleep 10
    for sock in $ACTIVE_SOCKS; do
      IFACE=$(basename "$sock")
      [ -d "/sys/class/net/$IFACE" ] || continue
      (
        iw dev "$IFACE" station dump 2>/dev/null \
          | awk '/^Station/ {print $2}'
          
        # For Wi-Fi 7 Multi-Link Operation (MLO) devices the actual MAC address is
        # in the "mld addr" line, otherwise use the MAC from the first match.
        iwinfo "$IFACE" assoclist 2>/dev/null \
          | awk '
            /^[0-9a-fA-F]{2}(:[0-9a-fA-F]{2}){5}/ {
              if (device_mac != "")
                print device_mac

              device_mac=tolower($1)
              next
            }
            /mld addr:/ {
              print tolower($3)
              device_mac=""
            }
            END {
              if (device_mac != "")
                print device_mac
            }'
      ) \
      | sort -u \
      | while read -r MAC; do
          [ -n "$MAC" ] && "$ACTION" "$IFACE" "AP-STA-CONNECTED" "$MAC"
        done
    done
  ) >/dev/null 2>&1 &
}

service_triggers() {
  # Restart when wireless is reloaded
  procd_add_reload_trigger "wireless"
}
