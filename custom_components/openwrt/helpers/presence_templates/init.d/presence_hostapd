#!/bin/sh /etc/rc.common
# OpenWrt procd service for hostapd_cli action hooks

START=95
STOP=10
USE_PROCD=1

ACTION="/etc/presence/presence_event.sh"

start_service() {
  [ -x "$ACTION" ] || return 0

  # Detect active interfaces purely from the live hostapd control sockets that
  # respond to a ping. If hostapd is still initializing (e.g. during boot or DFS CAC),
  # retry briefly in a background loop before giving up.
  ACTIVE_IFACES=""
  for sock in /var/run/hostapd/*; do
    [ -e "$sock" ] || continue
    IFACE=$(basename "$sock")
    [ "$IFACE" = "global" ] && continue
    if hostapd_cli -i "$IFACE" ping 2>/dev/null | grep -q PONG; then
      ACTIVE_IFACES="$ACTIVE_IFACES $IFACE"
    fi
  done

  # If no healthy interface answered yet, launch background retry to restart service
  # once hostapd finishes starting up (e.g. on 5GHz DFS wait or slow boot).
  if [ -z "$ACTIVE_IFACES" ]; then
    (
      for _i in $(seq 1 12); do
        sleep 5
        for sock in /var/run/hostapd/*; do
          [ -e "$sock" ] || continue
          _cand=$(basename "$sock")
          [ "$_cand" = "global" ] && continue
          if hostapd_cli -i "$_cand" ping 2>/dev/null | grep -q PONG; then
            /etc/init.d/presence_hostapd restart
            exit 0
          fi
        done
      done
    ) >/dev/null 2>&1 &
    return 0
  fi

  for IFACE in $ACTIVE_IFACES; do
    procd_open_instance "$IFACE"
    procd_set_param command /usr/sbin/hostapd_cli -i "$IFACE" -a "$ACTION"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
  done

  # Initial scan of currently connected stations upon service start
  (
    sleep 10
    for IFACE in $ACTIVE_IFACES; do
      [ -d "/sys/class/net/$IFACE" ] || continue
      iw dev "$IFACE" station dump 2>/dev/null \
        | awk '/^Station/ {print $2}' \
        | while read -r MAC; do
            [ -n "$MAC" ] && "$ACTION" "$IFACE" "AP-STA-CONNECTED" "$MAC"
          done
    done
  ) >/dev/null 2>&1 &
}

service_triggers() {
  # Restart when wireless is reloaded
  procd_add_reload_trigger "wireless"
}
